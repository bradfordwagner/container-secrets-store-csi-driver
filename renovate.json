{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bradfordwagner/renovate:argo-workflow"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dockerfile FROM line embedded in workflow.yaml",
      "managerFilePatterns": [
        "/^workflow\\.ya?ml$/"
      ],
      "matchStrings": [
        "FROM\\s+(?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}
